# Conexão do pooler (porta 6543 no Supabase) — usada pela aplicação
DATABASE_URL=postgresql://postgres:password@localhost:5432/jjcar
# Conexão direta (porta 5432 no Supabase) — usada apenas para migrations
DIRECT_URL=postgresql://postgres:password@localhost:5432/jjcar
# OBRIGATÓRIO em produção, mínimo 32 caracteres (o servidor recusa subir sem isso)
JWT_SECRET=sua-chave-secreta-aqui-minimo-32-caracteres
JWT_EXPIRES_IN=7d

STORAGE_BUCKET=jjcar-fotos
STORAGE_URL=https://seu-bucket.supabase.co/storage/v1
STORAGE_KEY=sua-chave-storage

ADMIN_EMAIL=admin@jjcar.com
ADMIN_LOGIN=JJCAR.ADMIN
ADMIN_SENHA=Trocar@123

API_PORT=3001
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:3001
