{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@jjcar/shared": ["../../packages/shared/src/index.ts"],
      "@jjcar/db": ["../../packages/db/src/index.ts"]
    }
  },
  "include": ["src"]
}
